---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Tile from '../components/Tile.astro';
import Lines from '../components/Lines.astro';
import '@fontsource/gelasio/400.css';
import '@fontsource/gelasio/700.css';
import '@fontsource/jost/700.css';
import '@fontsource/montserrat/800.css';
import { story } from '../data/wedding.js';

// Every image in src/assets/our-story/, keyed by file name.
const byName = (files) => Object.fromEntries(Object.entries(files).map(([path, image]) => [path.split('/').pop(), image]));
const images = byName(import.meta.glob('../assets/our-story/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}', { eager: true, import: 'default' }));

// One wavy edge, 1080 wide like the mockup, rising and dipping 30 units.
const wave = 'C90 0 90 29.7 180 29.7 C270 29.7 270 0 360 0 C450 0 450 29.7 540 29.7 C630 29.7 630 0 720 0 C810 0 810 29.7 900 29.7 C990 29.7 990 0 1080 0';
// A section's bottom edge, hanging below it: 30 units deep, low at the sides
// (or high, with `flip`). `dy` moves it down, for the coloured line under it.
const edge = (flip, dy) => {
  const lo = 29.7 + dy, hi = dy;
  const [a, b] = flip ? [hi, lo] : [lo, hi];
  let d = `M0 0 V${a}`;
  for (let x = 0; x < 1080; x += 360) d += ` C${x + 90} ${a} ${x + 90} ${b} ${x + 180} ${b} C${x + 270} ${b} ${x + 270} ${a} ${x + 360} ${a}`;
  return `${d} V0 Z`;
};

// A row of photos: each takes its share of the width, the wide ones more.
const columns = (photos) => photos.map((photo) => (photo.wide ? '293.4fr' : '164fr')).join(' ');
---
<Base title={story.title} overlay>
  <div class="story">
  <header class="hero">
    <!-- The whole photo, larger than the hero and cropped by it as in the
         mockup, with the title and the two lines curving around the couple
         drawn over it. Coordinates are the mockup's, so they stay lined up
         with the photo however it's cropped. -->
    <div class="stage">
      <Photo src={images[story.hero.file]} alt={story.hero.alt} ratio={null} />
      <svg class="lettering" viewBox="0.24 -159.92 1173.2 782.65" aria-hidden="true">
        <path id="left-line" d="M32.4 488.5 C39.8 488.2 64.9 488.9 76.8 487.0 C88.7 485.2 93.3 483.9 104.0 477.4 C114.7 470.9 130.6 459.2 141.1 448.0 C151.6 436.8 160.6 420.0 167.0 410.2 C173.4 400.3 174.5 396.4 179.6 388.7 C184.8 380.9 191.6 371.5 197.9 363.7 C204.3 355.8 210.1 349.2 217.7 341.8 C225.3 334.3 235.1 325.6 243.5 319.0 C251.9 312.3 257.7 308.1 267.9 301.8 C278.2 295.4 295.8 286.2 304.9 280.7 C314.0 275.2 318.0 272.0 322.6 268.9 C327.1 265.8 330.7 263.1 332.3 261.9" />
        <path id="right-line" d="M572.6 175.1 C578.4 171.5 595.9 158.2 607.4 153.8 C618.9 149.4 630.8 148.4 641.7 148.8 C652.7 149.1 663.8 152.1 673.2 155.9 C682.6 159.8 690.8 164.8 698.4 172.0 C706.0 179.1 711.8 187.9 718.9 198.8 C726.0 209.7 734.0 226.9 740.9 237.5 C747.8 248.1 754.2 255.2 760.1 262.3 C766.1 269.4 769.4 273.2 776.7 280.2 C784.0 287.3 796.2 298.2 804.0 304.6 C811.8 311.1 814.9 313.4 823.4 318.9 C832.0 324.5 845.3 332.3 855.1 337.8 C864.9 343.2 872.3 346.7 882.1 351.7 C891.9 356.8 904.9 362.9 913.7 368.3 C922.4 373.7 927.8 377.9 934.8 384.0 C941.8 390.1 949.3 397.4 955.9 404.9 C962.4 412.5 969.8 423.5 973.9 429.3 C978.0 435.0 979.3 437.7 980.4 439.3" />
        <text class="title" x="24.7" y="162.4" textLength="360.5" lengthAdjust="spacingAndGlyphs">{story.title}</text>
        <text class="line"><textPath href="#left-line" textLength="386" lengthAdjust="spacingAndGlyphs">{story.hero.left}</textPath></text>
        <text class="line"><textPath href="#right-line" textLength="528" lengthAdjust="spacingAndGlyphs">{story.hero.right}</textPath></text>
      </svg>
    </div>
    <h1 class="visually-hidden">{story.title}</h1>
    <p class="visually-hidden">{story.hero.left} {story.hero.right}</p>
  </header>

  {story.sections.map(({ theme, quote, years, blurb, story: text, intro, grid, tiles, rows, strip, outro, wave: bottom }, i) => (
    <section class:list={['part', theme, { first: i === 0 }]}>
      {i === 0 && (
        <svg class="wave top" viewBox="0 0 1080 31" preserveAspectRatio="none" aria-hidden="true"><path d={`M0 0 ${wave} V31 H0 Z`} /></svg>
      )}
      {quote && (
        <Fragment>
          <p class="quote"><Lines text={quote} script /></p>
          <div class="dots"></div>
        </Fragment>
      )}

      {years && blurb && (
        <div class="band">
          <h2 class="years">{years}</h2>
          <p class="blurb"><Lines text={blurb} /></p>
        </div>
      )}

      {years && text && (
        <div class="flow">
          <h2 class="years">{years}</h2>
          <p><Lines text={text} /></p>
        </div>
      )}

      {intro?.map((para) => <p class="text intro"><Lines text={para} /></p>)}

      {grid && (
        <ul class:list={['grid', { square: tiles === 'square' }]}>
          {grid.map((photo) => (
            <li class:list={['frame', { big: photo.big }]}>
              {photo.file ? (
                <Tile {...photo} src={images[photo.file]} sizes={photo.big ? '50vw' : '25vw'} />
              ) : (
                <div class="blank" title={photo.missing}></div>
              )}
            </li>
          ))}
        </ul>
      )}

      {rows?.map((row) => (
        <figure class="row">
          <ul class:list={{ six: row.photos.length > 5 }} style={`grid-template-columns: ${columns(row.photos)}`}>
            {row.photos.map((photo) => (
              <li class="frame">
                {photo.file ? (
                  <Tile {...photo} src={images[photo.file]} sizes={photo.wide ? '28vw' : '16vw'} />
                ) : (
                  <div class="blank" title={photo.missing}></div>
                )}
              </li>
            ))}
          </ul>
          {row.caption && (
            <figcaption>
              <strong>{row.caption[0]}</strong> {row.caption[1]}
              <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0.5 15.5 8.5H10.6V15.5H5.4V8.5H.5Z" /></svg>
            </figcaption>
          )}
        </figure>
      ))}

      {strip && (
        <ul class="strip">
          {strip.map((photo) => (
            <li>
              {photo.file ? <Tile {...photo} src={images[photo.file]} sizes="20vw" /> : <div class="blank" title={photo.missing}></div>}
            </li>
          ))}
        </ul>
      )}

      {outro?.map((para) => <p class="text outro"><Lines text={para} /></p>)}

      {bottom && (
        <svg class="wave bottom" viewBox="0 0 1080 41.7" preserveAspectRatio="none" aria-hidden="true" style={`--edge: var(--${bottom.edge})`}>
          <path class="edge" d={edge(bottom.flip, 12)} />
          <path d={edge(bottom.flip, 0)} />
        </svg>
      )}
    </section>
  ))}
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="full" alt="" />
    <button class="close" type="button" aria-label="Close">×</button>
    <button class="nav prev" type="button" aria-label="Previous photo">‹</button>
    <button class="nav next" type="button" aria-label="Next photo">›</button>
  </dialog>
</Base>

<script>
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.tile')];
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const full = dialog.querySelector<HTMLImageElement>('.full')!;
  let current = 0;

  // Show tile i full-size: the whole photo, uncropped, but still black and
  // white if the tile is.
  function show(i: number) {
    current = (i + tiles.length) % tiles.length;
    const img = tiles[current].querySelector('img')!;
    full.srcset = img.srcset;
    full.sizes = '100vw';
    full.src = img.src;
    full.alt = img.alt;
    full.style.filter = img.style.filter;
  }

  tiles.forEach((tile, i) =>
    tile.addEventListener('click', () => {
      show(i);
      dialog.showModal();
    }),
  );

  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.next')!.addEventListener('click', () => show(current + 1));

  // Clicking the dark area around the photo closes it.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  let touchX: number | null = null;
  dialog.addEventListener('touchstart', (event) => (touchX = event.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (event) => {
    if (touchX === null) return;
    const dx = event.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    touchX = null;
  });
</script>

<style>
  /* Everything is measured in mockup units: the mockup is 1080 units wide, so
     1u is 1/1080 of the page width at any screen size and the page looks the
     same on a phone, just smaller. */
  .hero,
  .part {
    --u: calc(100cqw / 1080);
  }
  .story {
    --plum: #831e58;
    --deep-plum: #740d48;
    --cream: #fffcf0;
    --citron: #c5cc84;
    --slate: #616f6f;
    --teal: #294b4e;
    --mist: #90b2b3;
    container-type: inline-size;
  }
  /* Each section's background, text and heading colours. */
  .plum {
    --bg: var(--deep-plum);
    --years: var(--cream);
    color: var(--cream);
  }
  .slate {
    --bg: var(--slate);
    color: var(--cream);
  }
  .citron {
    --bg: var(--citron);
    --years: var(--teal);
    color: var(--teal);
  }
  .mist {
    --bg: var(--mist);
    --years: var(--teal);
    --dots: #7da9ab;
    color: var(--teal);
  }
  .forest {
    --bg: var(--teal);
    --years: var(--cream);
    --dots: var(--mist);
    color: var(--cream);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The mockup's window onto the photo: 1080 by 573, with the photo 1173.2
     wide, its left edge at the window's and its top 159.92 above it. */
  .hero {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1080 / 573;
  }
  .stage {
    position: absolute;
    top: calc(-159.92 * var(--u));
    left: 0;
    width: calc(1173.2 * var(--u));
    aspect-ratio: 3 / 2;
  }
  .stage :global(.photo) {
    width: 100%;
    height: 100%;
  }
  .lettering {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: 'Le Studio Nocturne', cursive;
    fill: var(--cream);
    pointer-events: none;
  }
  .lettering path {
    fill: none;
  }
  .title {
    font-size: 70px;
  }
  .line {
    font-size: 17.5px;
  }
  /* Phones show the whole photo, which leaves room above the couple for the
     title below the header. */
  @media (max-width: 600px) {
    .hero {
      aspect-ratio: 3 / 2;
    }
    .stage {
      top: 0;
      width: 100%;
    }
  }

  /* Every section after the first starts below the wave hanging into it from
     the one before. */
  .part {
    position: relative;
    padding: calc(41.7 * var(--u)) 0 calc(14.2 * var(--u));
    background: var(--bg);
  }
  .part.first {
    padding-top: 0;
  }
  .wave {
    display: block;
    width: 100%;
    fill: var(--bg);
  }
  /* The top edge waves up over the bottom of the photo. Both waves tuck 1px
     into the section so no seam shows between them. */
  .wave.top {
    position: absolute;
    bottom: calc(100% - 1px);
    height: calc(31 * var(--u) + 1px);
  }
  /* Hangs below the section over the next one, with a coloured line under it. */
  .wave.bottom {
    position: absolute;
    z-index: 1;
    top: calc(100% - 1px);
    height: calc(41.7 * var(--u));
  }
  .wave .edge {
    fill: var(--edge);
  }
  .band {
    display: grid;
    grid-template-columns: calc(63.6 * var(--u)) calc(225.7 * var(--u)) calc(52.2 * var(--u)) calc(678.6 * var(--u));
    align-items: center;
    height: calc(75 * var(--u));
    text-align: center;
  }
  .years {
    grid-column: 2;
    margin: 0;
    font-family: 'Montserrat', var(--sans);
    font-size: calc(40 * var(--u));
    font-weight: 800;
    line-height: 1;
    color: var(--years);
    white-space: nowrap;
  }
  .blurb,
  .text {
    margin: 0;
    font-family: 'Gelasio', Georgia, serif;
    font-size: calc(18 * var(--u));
    line-height: calc(24.7 * var(--u));
    font-variant-numeric: oldstyle-nums;
  }
  .blurb {
    grid-column: 4;
  }
  /* Text between photos sits the same distance from what's above and below. */
  .text {
    margin: calc(8 * var(--u)) 0;
    text-align: center;
  }
  .outro {
    margin: calc(10.9 * var(--u)) 0 0;
  }
  .outro + .outro {
    margin-top: calc(12.9 * var(--u));
  }
  .slate {
    padding-bottom: calc(10.2 * var(--u));
  }
  .mist {
    padding-bottom: calc(11.6 * var(--u));
  }
  .citron {
    padding-bottom: calc(15.2 * var(--u));
  }
  .forest {
    padding-bottom: calc(60 * var(--u));
  }

  /* A quote in script, centred, with a dotted line under it. */
  .quote {
    margin: 0;
    padding-top: calc(28.8 * var(--u));
    font-family: 'Le Studio Nocturne', cursive;
    font-size: calc(29.8 * var(--u));
    line-height: calc(42 * var(--u));
    text-align: center;
  }
  /* Dots 5.4u across, 11.24u apart. */
  /* This copy of the font draws the f of "for" further right than Canva's, so
     its tail hits the "ll" of "challenge" below. Wider spaces on the second
     line move "challenge" right, clear of it. */
  .forest .quote :global(.line:last-of-type) {
    word-spacing: 0.15em;
  }
  .dots {
    height: calc(5.4 * var(--u));
    margin: calc(28.9 * var(--u)) 0 calc(18.5 * var(--u));
    background: radial-gradient(circle closest-side, var(--dots) 92%, transparent) calc(2.6 * var(--u)) 0 / calc(11.24 * var(--u)) 100% repeat-x;
  }

  /* The years on the left, with a long paragraph flowing beside and under them. */
  /* 30.5u from the dots, whose own 18.5u margin below them folds into this. */
  .flow {
    margin: calc(30.5 * var(--u)) 0 calc(22 * var(--u));
    padding: 0 calc(62 * var(--u));
    font-family: 'Gelasio', Georgia, serif;
    font-size: calc(18 * var(--u));
    line-height: calc(24.7 * var(--u));
    font-variant-numeric: oldstyle-nums;
  }
  .flow .years {
    float: left;
    width: calc(282 * var(--u));
    margin-top: calc(2.5 * var(--u));
    padding-left: calc(8 * var(--u));
    text-align: left;
  }
  .flow p {
    margin: 0;
  }

  /* Photos side by side, each in a cream frame, with a caption under them. */
  .row {
    margin: 0;
  }
  .row + .row {
    margin-top: calc(16.7 * var(--u));
  }
  .row ul {
    display: grid;
    grid-auto-rows: calc(219.6 * var(--u));
    gap: calc(16.7 * var(--u));
    margin: 0;
    padding: 0 calc(31.9 * var(--u));
    list-style: none;
  }
  .row ul.six {
    gap: calc(13 * var(--u));
    padding: 0 calc(15.6 * var(--u));
  }
  .row figcaption {
    margin: calc(9 * var(--u)) 0 calc(38.1 * var(--u));
    font-family: 'Jost', var(--sans);
    font-size: calc(22 * var(--u));
    line-height: calc(30 * var(--u));
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }
  .row:last-of-type figcaption {
    margin-bottom: 0;
  }
  .row:has(figcaption) + .row {
    margin-top: 0;
  }
  .row strong {
    font-weight: 700;
  }
  .arrow {
    width: calc(15.5 * var(--u));
    height: calc(15.5 * var(--u));
    margin-left: calc(4 * var(--u));
    fill: currentColor;
  }
  .grid,
  .strip {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: calc(194.1 * var(--u));
    gap: calc(7.3 * var(--u));
    padding: 0 calc(11.5 * var(--u));
  }
  .grid.square {
    grid-auto-rows: calc(258.8 * var(--u));
    row-gap: calc(7.9 * var(--u));
  }
  .frame {
    min-width: 0;
    border: calc(3 * var(--u)) solid var(--cream);
  }
  .frame.big {
    grid-column: span 2;
    grid-row: span 2;
  }
  /* Five photos side by side inside one cream frame. */
  .strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: calc(217.9 * var(--u));
    margin: calc(7.7 * var(--u)) calc(11.5 * var(--u)) 0;
    padding: calc(4 * var(--u));
    background: var(--cream);
  }
  .strip li {
    min-width: 0;
  }
  /* A space saved for a photo that hasn't been added yet. */
  .blank {
    height: 100%;
    background: color-mix(in srgb, currentColor 18%, transparent);
  }

  .lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgba(24, 21, 18, 0.92);
  }
  .full {
    display: block;
    width: auto;
    height: auto;
    max-width: 92vw;
    max-height: 88vh;
    object-fit: cover;
  }
  .lightbox button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    font-family: var(--serif);
    font-size: 2.25rem;
    line-height: 1;
    color: #fff;
    background: rgba(0, 0, 0, 0.35);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }
  .lightbox button:hover {
    background: rgba(0, 0, 0, 0.6);
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }
  /* Keep the page behind from scrolling while a photo is open. */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
