---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { couple, wedding, weekend } from '../data/wedding.js';
---
<Base>
  <section class="hero">
    <Photo ratio="16 / 9" alt={`${couple.first} and ${couple.second}`} />
    <div class="hero-text">
      <p class="eyebrow">We're getting married!</p>
      <h1>{couple.first} <em>&amp;</em> {couple.second}</h1>
      <p class="eyebrow">{wedding.location} &nbsp;·&nbsp; {wedding.dateShort}</p>
    </div>
  </section>

  <section id="weekend" class="section container">
    <h2>The Weekend</h2>
    <hr class="divider" />
    <ol class="events">
      {weekend.map((event) => (
        <li class="event">
          <p class="eyebrow">{event.day}</p>
          <h3>{event.title}</h3>
          <p class="time">{event.time}</p>
          <p>
            {event.venue}<br />
            <span class="muted">{event.address}</span>
          </p>
          {event.attire && <p class="muted">Attire: {event.attire}</p>}
          {event.notes?.map((note) => <p class="note">{note}</p>)}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero {
    position: relative;
  }
  .hero :global(.photo) {
    max-height: 80vh;
    min-height: 26rem;
  }
  .hero-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    text-align: center;
  }
  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
  }
  .hero h1 em {
    color: var(--accent);
  }
  .events {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 3rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .event p {
    margin: 0 0 0.75rem;
  }
  .time {
    font-family: var(--serif);
    font-size: 1.3rem;
  }
  .muted,
  .note {
    color: var(--muted);
  }
  .note {
    font-size: 0.95rem;
    font-style: italic;
  }
</style>
