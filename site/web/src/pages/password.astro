---
// Shown by nginx in place of any page until the visitor enters the site
// password; see nginx.conf. Doesn't use Base so it leaks nothing about the site.
import '../styles/global.css';
import { couple } from '../data/wedding.js';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{couple.first} &amp; {couple.second}</title>
  </head>
  <body>
    <main class="gate">
      <p class="monogram">{couple.monogram}</p>
      <h1>{couple.first} <em>&amp;</em> {couple.second}</h1>
      <form>
        <label for="password">Enter the password to continue</label>
        <input id="password" type="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" required />
        <button class="button" type="submit">Enter</button>
        <p class="error" role="alert" hidden>That's not quite right. Try again?</p>
      </form>
    </main>

    <script>
      const form = document.querySelector('form')!;
      const input = document.querySelector<HTMLInputElement>('#password')!;
      const error = document.querySelector<HTMLElement>('.error')!;

      // Case and surrounding spaces don't matter, so phone keyboards that
      // capitalize the first letter don't trip guests up.
      async function sha256(text: string) {
        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.hidden = true;
        const hash = await sha256(input.value.trim().toLowerCase());
        // Remembered for a year, so each device only asks once.
        document.cookie = `blm_auth=${hash}; Max-Age=31536000; Path=/; SameSite=Lax; Secure`;

        const res = await fetch(location.href, { method: 'HEAD', cache: 'no-store' });
        if (res.status === 401) {
          document.cookie = 'blm_auth=; Max-Age=0; Path=/; SameSite=Lax; Secure';
          error.hidden = false;
          input.select();
          return;
        }
        if (location.pathname.startsWith('/password')) location.replace('/');
        else location.reload();
      });
    </script>
  </body>
</html>

<style>
  .gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 2rem 1.25rem;
    text-align: center;
  }
  .monogram {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin: 0 0 1.5rem;
    font-family: var(--serif);
    font-size: 1.35rem;
    border: 1px solid var(--text);
    border-radius: 50%;
  }
  h1 em {
    color: var(--accent);
  }
  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: min(20rem, 100%);
  }
  label {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  input {
    width: 100%;
    padding: 0.75rem 1rem;
    font: inherit;
    text-align: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  input:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  .error {
    margin: 0;
    color: #a3412f;
  }
</style>
