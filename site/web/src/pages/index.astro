---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Squiggle from '../components/Squiggle.astro';
import { couple, heroPhoto, weekend } from '../data/wedding.js';

// Every image in src/assets/hero/, keyed by file name.
const files = import.meta.glob('../assets/hero/*.{jpg,jpeg,png,webp,avif}', { eager: true, import: 'default' });
const images = Object.fromEntries(Object.entries(files).map(([path, image]) => [path.split('/').pop(), image]));
---
<Base overlay>
  <Photo
    src={images[heroPhoto]}
    ratio={null}
    alt={`${couple.first} and ${couple.second}`}
  />
  <section class="section">
    <h1 class="weekend-title container">The Weekend</h1>
    <Squiggle />
    <ol class="events container">
      {weekend.map((event) => (
        <li class="event">
          <p class="eyebrow">{event.day}</p>
          <h3>{event.title}</h3>
          <p class="time">{event.time}</p>
          <p>
            {event.venue}<br />
            <span class="muted">{event.address}</span>
          </p>
          {event.attire && <p class="muted">Attire: {event.attire}</p>}
          {event.notes?.map((note) => <p class="note">{note}</p>)}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .weekend-title {
    margin-bottom: 1.25rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
  }
  .events {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 3rem 2rem;
    margin: 3rem auto 0;
    padding: 0 1.25rem;
    list-style: none;
  }
  .event p {
    margin: 0 0 0.75rem;
  }
  .time {
    font-family: var(--serif);
    font-size: 1.3rem;
  }
  .muted,
  .note {
    color: var(--muted);
  }
  .note {
    font-size: 0.95rem;
    font-style: italic;
  }
</style>


