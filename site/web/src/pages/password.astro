---
// Shown by nginx in place of any page until the visitor enters the site
// password; see nginx.conf. Doesn't use Base so it leaks nothing about the site.
import { Image } from 'astro:assets';
import '../styles/global.css';
import { couple } from '../data/wedding.js';

// The background, from the private repo's Home folder like the other photos.
// nginx lets this one photo through before login, by its name; keep the two in
// step if it changes (see nginx.conf).
import background from '../assets/home/PasswordScreen.jpg';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{couple.first} &amp; {couple.second}</title>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      {background && <Image src={background} alt="" widths={[800, 1400, 2000, 2800]} sizes="100vw" loading="eager" />}
    </div>

    <main class="gate">
      <h1>We’re getting married!</h1>
      <form>
        <label for="password">Enter the password to continue</label>
        <input id="password" type="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" required />
        <button type="submit">Enter</button>
        <p class="error" role="alert" hidden>That's not quite right. Try again?</p>
      </form>
    </main>

    <script>
      const form = document.querySelector('form')!;
      const input = document.querySelector<HTMLInputElement>('#password')!;
      const error = document.querySelector<HTMLElement>('.error')!;

      // Case and surrounding spaces don't matter, so phone keyboards that
      // capitalize the first letter don't trip guests up.
      async function sha256(text: string) {
        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.hidden = true;
        const hash = await sha256(input.value.trim().toLowerCase());
        // Remembered for a year, so each device only asks once.
        document.cookie = `blm_auth=${hash}; Max-Age=31536000; Path=/; SameSite=Lax; Secure`;

        const res = await fetch(location.href, { method: 'HEAD', cache: 'no-store' });
        if (res.status === 401) {
          document.cookie = 'blm_auth=; Max-Age=0; Path=/; SameSite=Lax; Secure';
          error.hidden = false;
          input.select();
          return;
        }
        if (location.pathname.startsWith('/password')) location.replace('/');
        else location.reload();
      });
    </script>
  </body>
</html>

<style is:global>
  /* Paid script font, copied in from the private repo; see `make fonts`. */
  @font-face {
    font-family: 'Le Studio Nocturne';
    src: url('../fonts/le-studio-nocturne.woff2') format('woff2');
    font-display: swap;
  }
</style>

<style>
  /* Measured in the mockup's units: it's 1080 by 720, so 1u is 1/1080 of the
     window's width, or 1/720 of its height if that's smaller. Sizes have
     floors so the writing stays readable on a phone. */
  :root {
    --u: min(100vw / 1080, 100dvh / 720);
    --cream: #fffcf0;
    --pale: #e3e2b3;
    --green: #c5cc84;
  }

  /* Black and white, like the mockup, whatever the photo. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #4a4a4a;
  }
  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: calc(52 * var(--u)) 1rem calc(56 * var(--u));
    color: var(--cream);
    text-align: center;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
  }
  h1 {
    margin: 0;
    font-family: 'Le Studio Nocturne', cursive;
    font-size: max(calc(50 * var(--u)), 2.25rem);
    font-weight: 400;
    line-height: 1.6;
    color: inherit;
  }
  /* Low in the window: the button's bottom sits 205u above the window's. */
  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(max(calc(303 * var(--u)), 16rem), 100%);
    margin: auto 0 calc(149 * var(--u));
  }
  label,
  button {
    font-family: var(--sans);
    font-size: max(calc(15 * var(--u)), 0.85rem);
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  label {
    margin-bottom: max(calc(22 * var(--u)), 1rem);
  }
  /* The mockup's borders sit inside the boxes, 3u thick. */
  input,
  button {
    height: max(calc(37.2 * var(--u)), 2.6rem);
    border: max(calc(3 * var(--u)), 2px) solid var(--pale);
    border-radius: 0;
  }
  input {
    width: 100%;
    padding: 0 1rem;
    font: inherit;
    text-align: center;
    color: #000;
    background: var(--cream);
  }
  input:focus {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  button {
    margin-top: max(calc(21.75 * var(--u)), 1rem);
    padding: 0 max(calc(17 * var(--u)), 1rem);
    color: #000;
    background: var(--green);
    cursor: pointer;
    text-shadow: none;
  }
  button:hover {
    background: color-mix(in srgb, var(--green) 85%, #000);
  }
  .error {
    margin: 1rem 0 0;
    font-size: max(calc(15 * var(--u)), 0.9rem);
  }
</style>
