---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import background from '../assets/home/ErrorPage.jpg';
---
<Base title="Not found" overlay>
  <section class="lost">
    <Image class="backdrop" src={background} alt="" widths={[800, 1400, 2000, 2800]} sizes="100vw" loading="eager" />
    <h1>Oops! You’re too far off trail</h1>
    <a class="home" href="/">Go home</a>
  </section>
</Base>

<style>
  /* Measured in the mockup's units: it's 1080 by 720, so 1u is 1/1080 of the
     window's width, or 1/720 of its height if that's smaller. Sizes have
     floors so the writing stays readable on a phone. */
  .lost {
    --u: min(100vw / 1080, 100dvh / 720);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    /* The header floats over the photo, so start below it. */
    padding: calc(4.5rem + 67 * var(--u)) 1rem 2rem;
    color: #fffcf0;
    text-align: center;
    background: #4a5560;
  }
  /* The mockup shows the lower part of the tall photo: the cabin, the couple
     and the snow, with the clouds above for the writing. */
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 82%;
  }
  h1 {
    margin: 0;
    font-family: 'Le Studio Nocturne', cursive;
    font-size: max(calc(50 * var(--u)), 2.25rem);
    font-weight: 400;
    line-height: 1.6;
    color: inherit;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
  }
  /* Like the password page's button: green, with a pale border inside it. */
  .home {
    display: grid;
    place-items: center;
    height: max(calc(36 * var(--u)), 2.6rem);
    margin-top: max(calc(121 * var(--u)), 2.5rem);
    padding: 0 max(calc(17 * var(--u)), 1rem);
    font-family: var(--sans);
    font-size: max(calc(15 * var(--u)), 0.85rem);
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    background: #c5cc84;
    border: max(calc(3 * var(--u)), 2px) solid #e3e2b3;
  }
  .home:hover {
    background: color-mix(in srgb, #c5cc84 85%, #000);
  }
</style>
