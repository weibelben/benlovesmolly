---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { couple, heroPhoto } from '../data/wedding.js';

// Every image in src/assets/hero/, keyed by file name.
const files = import.meta.glob('../assets/hero/*.{jpg,jpeg,png,webp,avif}', { eager: true, import: 'default' });
const images = Object.fromEntries(Object.entries(files).map(([path, image]) => [path.split('/').pop(), image]));
---
<Base overlay>
  <Photo
    src={images[heroPhoto]}
    ratio={null}
    alt={`${couple.first} and ${couple.second}`}
  />
</Base>

