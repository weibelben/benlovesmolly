---
import '../styles/global.css';
import { couple, wedding, rsvpUrl } from '../data/wedding.js';

const { title } = Astro.props;

const links = [
  { href: '/#weekend', label: 'The Weekend' },
  { href: '/our-story/', label: 'Our Story' },
  { href: '/travel-and-stay/', label: 'Travel & Stay' },
  { href: '/things-to-do/', label: 'Things to Do' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/registry/', label: 'Registry' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href) => !href.startsWith('/#') && path.startsWith(href);
const names = `${couple.first} & ${couple.second}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} | ${names}` : names}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="monogram" href="/" aria-label={`${names} home`}>{couple.monogram}</a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>
            {links.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
              </li>
            ))}
            <li><a class="nav-rsvp" href={rsvpUrl}>RSVP</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="signoff">{couple.first} and {couple.second}</p>
      <p class="eyebrow">{wedding.dateShort}</p>
      <a class="button" href={rsvpUrl}>RSVP</a>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.getElementById('site-nav');
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  .container {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: #fff;
  }
  .skip-link:focus {
    top: 1rem;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .monogram {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--text);
    border-radius: 50%;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--brand);
  }
  .site-nav a[aria-current='page'] {
    box-shadow: inset 0 -1px 0 var(--brand);
  }
  .site-nav .nav-rsvp {
    margin-left: 0.5rem;
    color: #fff;
    background: var(--brand);
  }
  .site-nav .nav-rsvp:hover {
    color: #fff;
    background: var(--brand-dark);
  }
  .menu-toggle {
    display: none;
  }
  .site-footer {
    padding: 4rem 1.25rem;
    text-align: center;
    border-top: 1px solid var(--line);
  }
  .signoff {
    margin: 0 0 0.25rem;
    font-family: var(--serif);
    font-size: 2rem;
    font-style: italic;
  }
  .site-footer .eyebrow {
    margin-bottom: 1.75rem;
  }
  @media (max-width: 900px) {
    .header-inner {
      flex-wrap: wrap;
    }
    .menu-toggle {
      display: inline-flex;
      flex-direction: column;
      gap: 5px;
      padding: 0.65rem 0.6rem;
      background: none;
      border: 1px solid var(--line);
      cursor: pointer;
    }
    .bar {
      width: 22px;
      height: 2px;
      background: var(--text);
    }
    .site-nav {
      display: none;
      width: 100%;
      padding-bottom: 1rem;
    }
    .site-nav.open {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .site-nav .nav-rsvp {
      margin: 0.5rem 0 0;
    }
  }
</style>
