# Copied from Cloudflare Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=

# SHA-256 of the lowercased site password. To create a hash, run this command and copy the output:
# echo -n "password" | sha256sum
SITE_PASSWORD_HASH=

# Postgres admin password, used by `make psql` and to set up the API's role.
POSTGRES_PASSWORD=

# Password the API connects to Postgres with.
SITE_DB_PASSWORD=
