---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { couple, home } from '../data/wedding.js';

// Every image in src/assets/home/, keyed by file name.
const files = import.meta.glob('../assets/home/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}', { eager: true, import: 'default' });
const images = Object.fromEntries(Object.entries(files).map(([path, image]) => [path.split('/').pop(), image]));

// A wavy edge 1080 wide, rising and dipping 25.7 units every 180, as a filled
// shape `depth` deep. `startHigh` puts the crests at the sides; `dy` moves the
// edge down. `fromTop` fills from the edge down to the bottom, otherwise from
// the top down to the edge.
const edge = ({ startHigh, dy, depth, fromTop }) => {
  const lo = 25.7 + dy, hi = dy;
  const [a, b] = startHigh ? [hi, lo] : [lo, hi];
  let d = `M0 ${fromTop ? depth : 0} V${a}`;
  for (let x = 0; x < 1080; x += 360) d += ` C${x + 90} ${a} ${x + 90} ${b} ${x + 180} ${b} C${x + 270} ${b} ${x + 270} ${a} ${x + 360} ${a}`;
  return `${d} V${fromTop ? depth : 0} Z`;
};
---
<Base overlay>
  <div class="home">
    <!-- Coordinates below are the mockup's: 1080 wide, the photo 671 tall. -->
    <header class="hero">
      <Photo src={images[home.photo]} crop={home.crop} ratio={null} alt={home.alt} sizes="100vw" />
      <h1 class="visually-hidden">{couple.first} and {couple.second}, {home.date.join(' ')}</h1>
      <svg class="lettering" viewBox="0 0 1080 671" aria-hidden="true">
        <text class="names" x="93.2" y="153.6">{couple.first}</text>
        <text class="and" x="144.6" y="196.6">and</text>
        <text class="names" x="26.6" y="301.9">{couple.second}</text>
        <text class="date" x="903" y="479.7">{home.date[0]}</text>
        <text class="date" x="916.4" y="521.7">{home.date[1]}</text>
      </svg>
    </header>

    <section class="island">
      <!-- Waves up over the bottom of the photo: a citron line, then pale green. -->
      <svg class="wave top" viewBox="0 0 1080 36.8" preserveAspectRatio="none" aria-hidden="true">
        <path class="line" d={edge({ startHigh: false, dy: 0, depth: 36.8, fromTop: true })} />
        <path d={edge({ startHigh: false, dy: 10.6, depth: 36.8, fromTop: true })} />
      </svg>

      <h2 class="place">
        <svg viewBox="0 0 1080 180" role="img" aria-label={home.place}>
          <text x="226.1" y="115.6">{home.place}</text>
        </svg>
      </h2>

      <!-- Waves down into the cream below, with a citron line under it. -->
      <svg class="wave bottom" viewBox="0 0 1080 36.5" preserveAspectRatio="none" aria-hidden="true">
        <path class="line" d={edge({ startHigh: true, dy: 10.8, depth: 36.5, fromTop: false })} />
        <path d={edge({ startHigh: true, dy: 0, depth: 36.5, fromTop: false })} />
      </svg>
    </section>
  </div>
</Base>

<style>
  /* Measured in mockup units: 1u is 1/1080 of the page width. */
  .home {
    --pale: #e3e2b3;
    --citron: #c5cc84;
    --cream: #fffcf0;
    --forest: #285133;
    container-type: inline-size;
    background: var(--cream);
  }
  .hero,
  .island {
    --u: calc(100cqw / 1080);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero {
    position: relative;
  }
  .hero :global(.photo) {
    aspect-ratio: 1080 / 671;
  }
  .lettering {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: 'Le Studio Nocturne', cursive;
    fill: var(--cream);
    pointer-events: none;
  }
  .names {
    font-size: 70px;
  }
  .and {
    font-size: 25.2px;
  }
  .date {
    font-size: 30px;
    fill: var(--forest);
  }

  /* The pale green section, as tall as in the mockup (it's empty below the
     title for now), then the cream page below its bottom wave. */
  .island {
    position: relative;
    height: calc(972.4 * var(--u));
    margin-bottom: calc(36.5 * var(--u));
    background: var(--pale);
  }
  .wave {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    fill: var(--pale);
  }
  .wave .line {
    fill: var(--citron);
  }
  /* Its bottom sits 8.5u into the section, where the pale green starts at the sides. */
  .wave.top {
    top: calc(-28.3 * var(--u));
    height: calc(36.8 * var(--u));
  }
  .wave.bottom {
    top: calc(100% - 1px);
    height: calc(36.5 * var(--u));
  }
  .place {
    margin: 0;
  }
  .place svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: 'Le Studio Nocturne', cursive;
    font-size: 71.5px;
    font-weight: 400;
    fill: var(--cream);
  }
</style>
