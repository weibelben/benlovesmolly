---
// Renders a photo, or a soft placeholder block until real photos are added.
const { src, alt = '', ratio = '3 / 2', label = 'Photo coming soon' } = Astro.props;
---
{src ? (
  <img class="photo" src={src} alt={alt} loading="lazy" style={`aspect-ratio: ${ratio}`} />
) : (
  <div class="photo placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={alt || label}>
    <span>{label}</span>
  </div>
)}

<style>
  .photo {
    display: block;
    width: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    background: linear-gradient(135deg, #ece5da, #dfe3d6);
  }
</style>
